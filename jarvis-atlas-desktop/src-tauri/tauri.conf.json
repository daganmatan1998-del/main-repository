{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Agent Atlas",
  "version": "0.1.0",
  "identifier": "com.daganmatan.jarvisatlas",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS Agent Atlas",
        "width": 1600,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "backgroundColor": "#05090d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Map of the JARVIS agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
