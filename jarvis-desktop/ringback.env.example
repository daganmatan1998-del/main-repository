# JARVIS phone calls (ringback). Copy this file to:
#
#     %APPDATA%\JARVIS\ringback.env
#
# (paste that path in Explorer's address bar; create the JARVIS folder if it is not there),
# then replace the three CHANGE_ME values with your Linphone account. Plain KEY=value lines,
# no spaces around the "=". Never send this file to anyone.

VOICE_SIP_ID=sip:CHANGE_ME@sip.linphone.org
VOICE_SIP_USER=CHANGE_ME
VOICE_SIP_PASS=CHANGE_ME

# Optional. Leave out unless you know you need them.
# VOICE_DISPLAY_NAME=JARVIS
# VOICE_STUN=stun.l.google.com:19302
