{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site-main",
  "description": "The same permissions as the 'default' capability, for the same window, when its page is loaded from the Cloudflare site instead of from inside the app. Tauri refuses every call from a remote page unless a capability names that address, so without this the page on the site could not show, move or invoke anything. This one site only.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://jarvis-main-version.daganmatan1998.workers.dev/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:app:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-center",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-settings:*"
        },
        {
          "url": "microsoft.windows.camera:*"
        }
      ]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
