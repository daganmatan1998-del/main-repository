{
  "name": "read-and-defend",
  "version": "1.0.0",
  "private": true,
  "description": "Read & Defend — a bilingual (Hebrew/English) castle-defense reading game for children.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "stt-proxy": "node server/stt-proxy.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/cli": "6.2.2",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "6.0.1",
    "@capacitor/core": "6.2.2"
  }
}
