# Security headers for Cloudflare Workers Static Assets / Pages.
# The script hash is the inline theme script in index.html — update it if that script changes
# (python3 -c "import re,hashlib,base64;s=open('www/index.html').read();print(base64.b64encode(hashlib.sha256(re.search(r'<script>(.*?)</script>',s,re.S).group(1).encode()).digest()).decode())").
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-9eNAwO+Kiswt/PhIRN94Vd0PBgo+ODZCiyld1eUgmDQ='; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), geolocation=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
