# Local development only (npm run dev). In production, set each one as a Worker secret:
#   npx wrangler secret put GOOGLE_API_KEY
#
# Every key is optional and worth one free tier. The assistant rotates between
# the ones you set, and a provider that runs out of quota rests for a few minutes.
# Use one key per provider; several accounts at one provider breaks its terms.
GOOGLE_API_KEY=            # aistudio.google.com/apikey            (sees images)
MISTRAL_API_KEY=           # console.mistral.ai                    (sees images)
GITHUB_MODELS_TOKEN=       # github.com/settings/tokens, models:read (sees images)
GROQ_API_KEY=              # console.groq.com/keys                 (sees images)
NVIDIA_API_KEY=            # build.nvidia.com                      (sees images)
OPENROUTER_API_KEY=        # openrouter.ai/keys, ":free" models    (sees images)
CEREBRAS_API_KEY=          # cloud.cerebras.ai                     (text only)
XAI_API_KEY=               #                                        (sees images)

# The paid engine. Body-fat estimate: tried FIRST (accuracy matters most), the
# free vision engines take over when it is out of credits or down. Calorie camera
# and assistant: the LAST resort, after every free engine failed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change a provider's model (free-tier model names change), or limit a task.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ENGINES_CHAT=google,groq          # only these, in this order
# ENGINES_MEALPHOTO=google,mistral
# MEALPHOTO_ALLOW_ANTHROPIC=0       # keep a task off Anthropic (also CHAT_ and BODYFAT_ALLOW_ANTHROPIC)
# Which Anthropic model answers what (defaults: Sonnet for chat and the calorie
# camera, Opus for the body-fat estimate):
# CLAUDE_MODEL_CHAT=claude-sonnet-5-5
# CLAUDE_MODEL_MEALPHOTO=claude-sonnet-5-5
# CLAUDE_MODEL_BODYFAT=claude-opus-5-5
