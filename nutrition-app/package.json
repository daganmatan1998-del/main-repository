{
  "name": "nutri",
  "version": "1.0.0",
  "private": true,
  "description": "Hebrew RTL nutrition-planning PWA with a Claude-powered assistant",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-server.mjs",
    "test": "node --import ./tests/unit/pin-he.mjs --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:cloud": "node tests/e2e/cloud.mjs",
    "test:i18n": "node tests/e2e/i18n.mjs",
    "deploy": "wrangler deploy",
    "flavors": "node scripts/make-flavor.mjs all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "dictionary-bg": "^2.0.0",
    "dictionary-cs": "^4.0.0",
    "dictionary-da": "^6.0.0",
    "dictionary-de": "^3.0.0",
    "dictionary-el": "^4.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-he": "^2.0.0",
    "dictionary-hu": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-ko": "^2.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-ro": "^3.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-sv": "^4.0.0",
    "dictionary-tr": "^2.0.0",
    "dictionary-uk": "^4.0.0",
    "dictionary-vi": "^3.0.0",
    "nspell": "^2.1.5",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
