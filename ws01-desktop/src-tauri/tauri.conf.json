{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WS-01",
  "version": "1.0.0",
  "identifier": "dev.daganmatan.ws01",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "מטול קורים WS-01",
        "width": 1320,
        "height": 900,
        "minWidth": 480,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
